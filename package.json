{
  "name": "triple-m-neuromuscular-atlas",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "typecheck": "tsc -b",
    "build": "npm run typecheck && vite build && npm run verify:publication",
    "preview": "vite preview --host 0.0.0.0",
    "lint": "eslint .",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "data:validate": ".venv/bin/python scripts/atlas/process_workbook.py",
    "data:validate:check": ".venv/bin/python scripts/atlas/process_workbook.py --check-only",
    "data:validate:core": ".venv/bin/python scripts/atlas/core_validation.py --full-audit esearch_sources/_processed/core_atlas/full_study_validation.private.json",
    "data:test": ".venv/bin/python -m unittest discover -s scripts/atlas/tests -v",
    "test:release-policy": "node --experimental-strip-types scripts/atlas/tests/atlas-release-policy.test.mjs",
    "test:aggregates": "node --experimental-strip-types scripts/atlas/tests/aggregate-evidence.test.mjs",
    "verify:publication": "node scripts/verify-publication.mjs"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "^7.2.0"
  }
}
